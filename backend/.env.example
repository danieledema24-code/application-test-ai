# Copy to backend/.env and fill in. Never commit .env. All values here are placeholders.

# development | test | production
ENV=development
LOG_LEVEL=INFO
LOG_JSON=false

# SQLite by default (file under backend/data/). Postgres by config only, e.g.
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/qa   (not the instance on :5432 used by another project)
# DATABASE_URL=sqlite+aiosqlite:////absolute/path/qa.db   (default: backend/data/qa.db)
# STORAGE_DIR=/absolute/path/storage                      (default: backend/data/storage)

# Required in production: SECRET_KEY >= 32 random chars; ENCRYPTION_KEY = 32 random bytes, base64.
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
SECRET_KEY=
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=k1

WEB_ORIGIN=http://localhost:3002
PUBLIC_API_URL=http://localhost:8200

# Dev/test only: lets the scanner reach the approved target on loopback (127.0.0.0/8, ::1), e.g. the demo shop
# on http://localhost:4100. LAN and link-local addresses stay blocked. Refused when ENV=production.
ALLOW_PRIVATE_TARGETS=false

# inline (worker inside the API process) | separate (run `uv run python -m app.worker`) | off
WORKER_MODE=inline
WORKER_CONCURRENCY=2

# AI: auto = Claude when ANTHROPIC_API_KEY is set, otherwise rule-based (labelled "rules").
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Discovery limits
SCAN_DEFAULT_MAX_PAGES=30
SCAN_MAX_PAGES_CAP=100
SCAN_TIME_LIMIT_S=1200
SCAN_POLITENESS_DELAY_MS=500
MAX_CONCURRENT_SCANS_PER_ORG=2
