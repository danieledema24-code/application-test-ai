DATABASE_URL="file:./dev.db"
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
# 32-byte base64 key for AES-256-GCM encryption of stored credentials/tokens
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""
PORT=4000
WEB_ORIGIN="http://localhost:3000"
STORAGE_DIR="./storage"
WORKER_CONCURRENCY=2
# Set to enable Claude-powered features; without it the app uses labelled rule-based fallbacks
# ANTHROPIC_API_KEY=
# Allow testing targets on localhost/private networks (dev only; the SSRF guard blocks them otherwise)
ALLOW_PRIVATE_TARGETS=true
